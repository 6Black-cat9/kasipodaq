    "file-type": "^22.1.1",
    "dotenv": "^16.4.7",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsx": "^4.19.3",
    "prisma": "6.5.0",
    "@types/node": "^22.13.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
